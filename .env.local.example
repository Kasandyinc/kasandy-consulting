# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Contact form emails (Resend)
RESEND_API_KEY=
# Verified Resend domain used for every outbound email.
# Defaults to kasandyconsulting.com; only set this if a subdomain is verified later.
RESEND_SENDING_DOMAIN=
CONTACT_TO_EMAIL=ea@kasandyconsulting.com

# Booking — Microsoft Teams link included in confirmations + the calendar invite
MEETING_LINK=

# Spam protection — Cloudflare Turnstile.
# Leave both blank to disable; the server-side check fails open when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# Square Payments
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Admin
ADMIN_PASSWORD=

# ── Hub (Supabase) ───────────────────────────────────────────────────────────
# The hub's own project. The website writes bookings here before it confirms
# anything, so an unreachable hub turns the public booking form into a 500.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# Comma-separated allow-list of operator emails permitted into the hub.
ENGINE_OPERATOR_EMAILS=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret for /api/engine/cron/* and /api/health. Vercel Cron sends it as a
# bearer token; the GitHub health workflow sends the same. Set the identical value
# as a GitHub Actions secret, or the health check fails with 401.
CRON_SECRET=
