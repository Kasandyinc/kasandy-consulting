# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Contact form emails (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=ea@kasandyconsulting.com

# Booking — Microsoft Teams link included in confirmations + the calendar invite
MEETING_LINK=

# Spam protection — Cloudflare Turnstile.
# Leave both blank to disable; the server-side check fails open when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# Square Payments
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Admin
ADMIN_PASSWORD=
